# Configure one or both cloud AI providers for tutorial text generation.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional default. Edge Neural TTS needs no API key and can also be changed in Settings.
EDGE_TTS_VOICE=en-US-AriaNeural

# Leave blank. Defaults to ~/.autotutorial-ai to keep media outside the Next.js project.
AUTOTUTORIAL_DATA_DIR=
