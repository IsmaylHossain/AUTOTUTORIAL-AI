# Choose Groq or Gemini as the AI provider. The app falls back to local steps when the provider is unavailable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
GEMINI_API_KEY=

# Leave blank. Defaults to ~/.autotutorial-ai to keep media outside the Next.js project.
AUTOTUTORIAL_DATA_DIR=
